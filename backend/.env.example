# ─── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=false

# ─── Camera ──────────────────────────────────────────────────────────────────
# MUST be 640x640 to prevent OpenVINO graph re-compilation deadlock
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=640
TARGET_FPS=60

# ─── YOLO ────────────────────────────────────────────────────────────────────
# Use the absolute path if possible, or the exact folder name
YOLO_MODEL=yolov8n_openvino_model
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.50
DEVICE=cpu

# ─── Stream ──────────────────────────────────────────────────────────────────
JPEG_QUALITY=60
STREAM_MAX_QUEUE=8